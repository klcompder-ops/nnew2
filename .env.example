# Supabase Configuration (untuk local development)
# Ambil dari: https://supabase.com > Project Settings > API

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Catatan:
# - Untuk deployment di Netlify, set variable ini via Netlify dashboard
# - Jangan pernah commit file ini ke Git (sudah di .gitignore)
# - ANON_KEY adalah public key, boleh di expose
# - SERVICE_ROLE_KEY jangan pernah di client-side code
